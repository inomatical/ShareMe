<Window x:Class="EagleShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EagleShare"
        Height="540" Width="900"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: application identity and receiver address placeholder. -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="EagleShare"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="AddressText"
                           Text="Receiver not started"
                           FontSize="12"
                           Foreground="#9CA3AF"/>
            </StackPanel>
        </Border>

        <!-- Body: inbox list and preview area. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           Text="Inbox"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="InboxList"
                         BorderThickness="1" BorderBrush="#E5E7EB"
                         DisplayMemberPath="Content"
                         SelectionChanged="InboxList_SelectionChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E5E7EB"/>

            <DockPanel Grid.Column="2" Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           Text="Preview"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Button x:Name="CopyButton"
                        DockPanel.Dock="Bottom"
                        Content="Copy"
                        Margin="0,8,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        IsEnabled="False"
                        Click="CopyButton_Click"/>
                <Button x:Name="SaveImageButton"
                        DockPanel.Dock="Bottom"
                        Content="Save As..."
                        Margin="0,8,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Click="SaveImageButton_Click"/>
                    <Button x:Name="SaveFileButton"
                        DockPanel.Dock="Bottom"
                        Content="Save As..."
                        Margin="0,8,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Click="SaveFileButton_Click"/>
                <Border BorderThickness="1" BorderBrush="#E5E7EB">
                    <Grid>
                        <TextBox x:Name="PreviewText"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Padding="12"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                        <ScrollViewer x:Name="ImagePreview"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <Image x:Name="ThumbnailImage"
                                       Height="96"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,12"/>
                                <Image x:Name="FullPreviewImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel x:Name="FilePreview"
                                    Margin="12"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="FileNameText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="FileTypeText"
                                       Margin="0,12,0,0"/>
                            <TextBlock x:Name="FileSizeText"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Status bar. -->
        <Border Grid.Row="2" Background="#F3F4F6" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="12"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="IncomingProgress"
                             Width="160"
                             Height="12"
                             Margin="12,0,0,0"
                             Minimum="0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
