<Window x:Class="EagleShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EagleShare"
        Height="540" Width="900"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: application identity and receiver address placeholder. -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="EagleShare"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="AddressText"
                           Text="Receiver not started"
                           FontSize="12"
                           Foreground="#9CA3AF"/>
            </StackPanel>
        </Border>

        <!-- Body: inbox list and preview area. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           Text="Inbox"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="InboxList"
                         BorderThickness="1" BorderBrush="#E5E7EB"/>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E5E7EB"/>

            <DockPanel Grid.Column="2" Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           Text="Preview"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Border BorderThickness="1" BorderBrush="#E5E7EB">
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Select an item to preview it."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#9CA3AF"/>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Status bar. -->
        <Border Grid.Row="2" Background="#F3F4F6" Padding="12,6">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="#374151"/>
        </Border>
    </Grid>
</Window>
